{
  "id": null,
  "uid": "blueos-esp-sensors",
  "title": "BlueOS ESP Sensors",
  "description": "Auto-provisioned for ESPHome nodes publishing under blueos/# via Telegraf -> InfluxDB 1.8 (esphome DB). Panels match sensors by name rather than listing them, so a sensor added to a board's firmware YAML appears here on its own: anything named *temperature* / *humidity* / *illuminance* lands on the matching panel with the right unit, and everything else numeric shows up under 'Other sensors'. Edit freely — this file is only re-applied when the extension is updated.",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["blueos", "esphome", "site-steward"],
  "templating": {
    "list": [
      {
        "name": "board",
        "label": "ESP board",
        "description": "Second segment of the MQTT topic, e.g. 'logger' for blueos/logger. Populated from whatever is publishing.",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
        "query": "SHOW TAG VALUES FROM \"esphome_sensor\" WITH KEY = \"topic\"",
        "regex": "/^blueos\\/([^\\/]+)\\//",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "logger", "value": "logger" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Temperature",
      "description": "Every sensor on this board whose name contains 'temperature', including an RTC chip's onboard sensor.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_sensor\" WHERE \"topic\" =~ /^blueos\\/$board\\/sensor\\/.*temperature.*\\/state$/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/sensor/(.*)/state", "renamePattern": "$1" }
        }
      ]
    },
    {
      "id": 11,
      "title": "Humidity",
      "description": "Every sensor on this board whose name contains 'humidity'.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_sensor\" WHERE \"topic\" =~ /^blueos\\/$board\\/sensor\\/.*humidity.*\\/state$/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/sensor/(.*)/state", "renamePattern": "$1" }
        }
      ]
    },
    {
      "id": 12,
      "title": "Illuminance",
      "description": "Every sensor on this board whose name contains 'illuminance', 'lux' or 'ambient_light'.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "lux",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_sensor\" WHERE \"topic\" =~ /^blueos\\/$board\\/sensor\\/.*(illuminance|lux|ambient_light).*\\/state$/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/sensor/(.*)/state", "renamePattern": "$1" }
        }
      ]
    },
    {
      "id": 13,
      "title": "WiFi signal",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_sensor\" WHERE \"topic\" = 'blueos/$board/sensor/wifi_signal/state' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "RSSI"
        }
      ]
    },
    {
      "id": 14,
      "title": "Other sensors",
      "description": "Anything numeric this board publishes that the panels above don't already cover — a new sensor lands here automatically, on a shared unitless axis. Give it its own panel if the scale doesn't suit.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_sensor\" WHERE \"topic\" =~ /^blueos\\/$board\\/sensor\\/.*\\/state$/ AND \"topic\" !~ /(temperature|humidity|illuminance|lux|ambient_light|wifi_signal|uptime|rtc_epoch)/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/sensor/(.*)/state", "renamePattern": "$1" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Switches (history)",
      "description": "Every switch this board exposes — relays, and anything else like a buzzer. Series identity is the stable ESPHome object id (relay_1, …), so renaming a relay in Site Controls does not break its history.",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "options": { "mergeValues": true, "showValue": "auto", "rowHeight": 0.7 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "ON": { "color": "green", "index": 0, "text": "ON" }, "OFF": { "color": "red", "index": 1, "text": "OFF" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT \"value\" FROM \"esphome_switch\" WHERE \"topic\" =~ /^blueos\\/$board\\/switch\\/.*\\/state$/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/switch/(.*)/state", "renamePattern": "$1" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Uptime",
      "description": "Board uptime from the ESP uptime sensor (seconds), shown as a human duration.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT last(\"value\") FROM \"esphome_sensor\" WHERE \"topic\" = 'blueos/$board/sensor/uptime/state' AND $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Uptime"
        }
      ]
    },
    {
      "id": 5,
      "title": "Device online",
      "description": "Whether this board is currently connected to the site mailbox (online/offline from the device status topic).",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "online": { "color": "green", "text": "Online" },
                "offline": { "color": "red", "text": "Offline" }
              }
            }
          ],
          "noValue": "No recent status"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "last", "values": false },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT last(\"value\") FROM \"esphome_status\" WHERE \"topic\" = 'blueos/$board/status'",
          "rawQuery": true,
          "resultFormat": "table"
        }
      ]
    },
    {
      "id": 15,
      "title": "Latest readings",
      "description": "Most recent value of every numeric sensor on this board, whether or not it has a panel above. Units vary by sensor, so the raw number is shown.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "esphome_influxdb" },
          "query": "SELECT last(\"value\") FROM \"esphome_sensor\" WHERE \"topic\" =~ /^blueos\\/$board\\/sensor\\/.*\\/state$/ AND $timeFilter GROUP BY \"topic\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_topic"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": { "regex": ".*/sensor/(.*)/state", "renamePattern": "$1" }
        }
      ]
    }
  ]
}
